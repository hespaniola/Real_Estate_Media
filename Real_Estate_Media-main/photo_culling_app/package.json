{
  "name": "photo-culling-studio",
  "productName": "Photo Culling Studio",
  "version": "1.0.0",
  "description": "Desktop photo culling app for photographers — sharpness, exposure, duplicate, face and composition analysis with fast accept/reject/favorite triage.",
  "author": "Hunter Espaniola",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-mediapipe-assets.mjs",
    "predev": "node scripts/copy-mediapipe-assets.mjs",
    "prebuild": "node scripts/copy-mediapipe-assets.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "test:analysis": "tsx scripts/test-analysis.mjs",
    "test:integration": "npm run build && tsx scripts/test-integration.mjs",
    "test:store": "tsx scripts/test-store-filters.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.17",
    "exifr": "^7.1.3",
    "sharp": "^0.33.5",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.hunterespaniola.photoCullingStudio",
    "productName": "Photo Culling Studio",
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "directories": {
      "buildResources": "resources"
    },
    "mac": {
      "category": "public.app-category.photography"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics"
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
